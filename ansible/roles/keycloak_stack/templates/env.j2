# {{ ansible_managed }}
# Secrets for the Keycloak stack, sourced from Azure Key Vault. Mode 0600.
# Values are single-quoted so Compose takes them literally (no ${...}
# interpolation); see keycloak_stack/tasks/main.yml for the "'" restriction.
POSTGRES_DB='{{ keycloak_db_name }}'
POSTGRES_USER='{{ keycloak_db_user }}'
POSTGRES_PASSWORD='{{ postgres_password }}'
KC_BOOTSTRAP_ADMIN_USERNAME='{{ keycloak_admin_user }}'
KC_BOOTSTRAP_ADMIN_PASSWORD='{{ keycloak_admin_password }}'
